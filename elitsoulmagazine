<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Elite Soul Magazine</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:#f7f7f5;color:#0a0a0a}
a{text-decoration:none;color:inherit}
header{height:78px;border-bottom:1px solid #ddd;display:flex;align-items:center;
justify-content:space-between;padding:0 6%;background:#fff;position:sticky;top:0;z-index:10}
.logo{font-size:25px;font-weight:900;letter-spacing:-1.5px}
.logo span{color:#16833b}
nav{display:flex;gap:30px;font-size:12px;font-weight:bold;text-transform:uppercase}
nav a:hover{color:#16833b}
.menu{display:none;font-size:25px}

.hero{min-height:650px;display:grid;grid-template-columns:1.1fr .9fr;background:#111;color:#fff}
.hero-img{background:url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1400&q=90') center/cover}
.hero-content{padding:10%;display:flex;flex-direction:column;justify-content:center}
.tag{font-size:11px;letter-spacing:3px;color:#4dcc75;font-weight:bold;margin-bottom:25px}
.hero h1{font-size:clamp(45px,6vw,82px);line-height:.92;letter-spacing:-4px;margin-bottom:28px}
.hero p{font-size:16px;line-height:1.7;color:#ccc;max-width:470px}
.btn{display:inline-block;background:#16833b;color:white;padding:15px 25px;
margin-top:35px;font-size:11px;font-weight:bold;text-transform:uppercase;width:max-content}
.btn:hover{background:#fff;color:#111}

section{padding:90px 6%}
.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px}
.section-head h2{font-size:42px;letter-spacing:-2px}
.section-head a{font-size:11px;font-weight:bold;text-transform:uppercase;color:#16833b}

.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.card{background:#fff}
.card-img{height:330px;background-size:cover;background-position:center}
.card-body{padding:22px}
.card .tag{margin-bottom:12px;font-size:9px}
.card h3{font-size:24px;line-height:1.05;letter-spacing:-1px;margin-bottom:12px}
.card p{font-size:13px;line-height:1.6;color:#666}

.split{background:#111;color:white;display:grid;grid-template-columns:1fr 1fr}
.split-content{padding:90px 12%}
.split h2{font-size:55px;line-height:.95;letter-spacing:-3px;margin-bottom:25px}
.split p{color:#bbb;line-height:1.7}
.split-img{min-height:500px;background:url('https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1200&q=90') center/cover}

.newsletter{text-align:center;background:#16833b;color:#fff}
.newsletter h2{font-size:45px;letter-spacing:-2px;margin-bottom:15px}
.newsletter p{margin-bottom:25px}
input{padding:17px;border:0;width:280px;max-width:80%;outline:none}
.newsletter button{padding:17px 25px;border:0;background:#111;color:#fff;font-weight:bold}

footer{background:#080808;color:#fff;padding:55px 6%;display:flex;justify-content:space-between}
footer p{font-size:12px;color:#888}
.footer-links{display:flex;gap:25px;font-size:11px;text-transform:uppercase}
.footer-links a:hover{color:#4dcc75}

@media(max-width:800px){
nav{display:none}.menu{display:block}
.hero{grid-template-columns:1fr}.hero-img{height:430px}.hero-content{padding:55px 7%}
.grid{grid-template-columns:1fr}.split{grid-template-columns:1fr}
.split-img{min-height:400px;grid-row:1}.split-content{padding:70px 8%}
.section-head h2{font-size:34px}footer{display:block}.footer-links{margin-top:25px}
}
</style>
</head>

<body>

